// Exemplo de ajustes locais do Hub (seção 12.1). Nada aqui é obrigatório: os valores abaixo são os padrões.
// Para mudar algo no PC do escritório, copie só as linhas necessárias para
// C:\MarumbiSom\Hub\app\appsettings.Production.json (fora do Git; o install-hub.ps1 não apaga esse arquivo)
// e reinicie o serviço MarumbiSom.Hub. Senhas não ficam aqui: a do painel é gravada no banco pelo install-hub.ps1.
{
  "Hub": {
    // Pasta de dados. Vazio = C:\MarumbiSom\Hub\data.
    "DataDirectory": "",
    // Porta em 127.0.0.1; o acesso das lojas e do celular é só pelo Tailscale Serve (tailscale serve --bg 5080).
    "Port": 5080,
    // ffmpeg e ffprobe da ingestão, relativos à pasta do Hub.
    "FfmpegPath": "tools\\ffmpeg.exe",
    "FfprobePath": "tools\\ffprobe.exe",
    // Hora e fuso da regeneração diária dos manifestos (seção 6.4).
    "DailyRegenerationTime": "00:05",
    "Timezone": "America/Sao_Paulo"
  },
  "Serilog": {
    "MinimumLevel": {
      // "Debug" para investigar um problema; volte para "Information" depois.
      "Default": "Information"
    }
  }
}
