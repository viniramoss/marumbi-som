// Exemplo de ajustes do agente da loja (seção 12.1). Nada aqui é obrigatório: os valores abaixo são os padrões.
// A página Configurar Som grava a caixa escolhida, o Hub e a senha local em C:\ProgramData\MarumbiSom\config.json,
// que tem precedência sobre o appsettings. Para outro ajuste, acrescente só a seção necessária nesse config.json
// (PowerShell como administrador) e reinicie o serviço MarumbiSom.Agent. O token da loja fica no config.json
// protegido por DPAPI; nunca copie esse arquivo para outro PC nem para o Git.
{
  "Bluetooth": {
    // MAC da caixa; normalmente escolhido na página Configurar Som.
    "SpeakerAddress": "",
    // InstanceId do adaptador USB. Vazio = detecta sozinho.
    "AdapterInstanceId": "",
    // Espera entre tentativas de reconectar a caixa (seção 9.1).
    "BackoffSeconds": [ 5, 10, 20, 40, 60 ],
    "VerifyDelaySeconds": 4,
    "PollSeconds": 2,
    // Reiniciar o adaptador no máximo 1 vez a cada N minutos (seção 9.2).
    "AdapterResetMinIntervalMinutes": 10
  },
  "Player": {
    "MpvPath": "tools\\mpv.exe"
  },
  "Agent": {
    // Pasta de dados. Vazio = C:\ProgramData\MarumbiSom.
    "DataDirectory": ""
  },
  "LocalConfig": {
    // Página Configurar Som, só em 127.0.0.1.
    "Port": 47800
  },
  "Sync": {
    // Limite de banda dos downloads de músicas e atualizações, em kbit/s (seção 8.3). 0 = sem limite.
    "BandwidthKbps": 2000
  }
}
